// erpide-panel database schema.
//
// Migration history: previously user/order/license state lived in a single
// JSON blob (`erpide-state.json`) on Vercel Blob. Hobby-plan advanced-op limit
// kept getting hit on every login, so we moved the hot path to a real DB.
// JSON-shaped sub-records (savedAddresses, items) are kept as Json columns —
// they're never queried independently.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id
  email        String @unique
  name         String
  surname      String
  passwordHash String

  emailVerified              Boolean   @default(false)
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?

  gsmNumber      String?
  identityNumber String?
  companyName    String?
  taxNumber      String?
  address        String?
  city           String?
  postalCode     String?
  district       String?

  // Array of SavedAddress — see UserRecord.savedAddresses in user-store.ts.
  savedAddresses Json?

  acceptedTermsAt    DateTime?
  acceptedKvkkAt     DateTime?
  marketingConsentAt DateTime?

  oauthProvider   String?
  oauthProviderId String?
  avatarUrl       String?

  iyzicoCardUserKey     String?
  iyzicoCardToken       String?
  iyzicoCardLastFour    String?
  iyzicoCardAssociation String?
  iyzicoCardSavedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@unique([oauthProvider, oauthProviderId], name: "oauth_provider_lookup")
  @@index([email])
}

model Order {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Array of OrderItem — license keys, sku ids, backend provisioning data.
  items          Json
  totalPrice     Float
  currency       String
  paymentId      String?
  conversationId String  @unique
  status         String

  iyzicoToken    String?
  isTrial        Boolean   @default(false)
  trialExpiresAt DateTime?
  /// "Denemen bitiyor" hatirlatmasi gonderildi — ayni mail iki kez gitmesin.
  trialReminderSent    DateTime?
  /// "Denemen bitti" bildirimi gonderildi.
  trialEndedNoticeSent DateTime?

  subscriptionExpiresAt DateTime?
  billingCycle          String?
  autoRenewEnabled      Boolean?
  lastRenewAttemptAt    DateTime?
  lastRenewError        String?
  renewedFromOrderId    String?

  /// Odeme anindaki fatura adresinin anlik goruntusu (SavedAddress).
  /// Fatura BU kayittan kesilir, kullanicinin guncel profilinden degil —
  /// profil sonradan degisirse vergi belgesi yanlis VKN tasimasin.
  billingSnapshot       Json?

  cancelledAt             DateTime?
  cancelledBy             String?
  cancellationReason      String?
  expiringSoonEmailSentAt DateTime?
  renewFailedEmailSentAt  DateTime?

  creditsConsumed Int?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([isTrial, status])
}

model LicenseCode {
  // Normalized code (uppercase, hyphens preserved) — see normalizeCode().
  code         String  @id
  skuId        String
  productId    String
  durationDays Int
  batchId      String?
  note         String?

  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  redeemedBy      String?
  redeemedAt      DateTime?
  redeemedOrderId String?

  @@index([batchId])
  @@index([redeemedBy])
}

model BankTransferRequest {
  // HAV-XXXXXXXX format.
  code       String @id
  userId     String
  userEmail  String
  productId  String
  skuIds     Json
  skuNames   Json?
  amountUSD  Float
  fxRate     Float
  fxRateDate String
  amountTRY  Float
  ibanUsed   String
  ibanHolder String
  status     String

  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  orderId         String?

  @@index([userId])
  @@index([status])
}

model DataEngineLicense {
  // Format: DE-XXXX-YYYY-ZZZZ-NNNN (15 chars + 4 dashes), normalize edilmiş upper-case.
  key       String    @id
  customer  String
  productId String    @default("dataengine")
  expiresAt DateTime?
  active    Boolean   @default(true)
  note      String?

  // Aktivasyon: ilk başarılı validate'de set; sonraki farklı fingerprint reject (gelecek faz).
  activeFingerprint String?
  firstSeenAt       DateTime?

  // İzleme: her başarılı validate'de güncellenir
  lastValidatedAt   DateTime?
  lastClientVersion String?
  lastSeenIp        String?

  createdAt DateTime @default(now())
  createdBy String? // admin userId / email

  @@index([active])
  @@index([expiresAt])
}

// ── Phase 2: panel auth / pocket / support ────────────────────────
// All these used to live on Vercel Blob (one blob per session, plus a few
// monolithic JSON files). Each login touched Blob's Advanced Ops quota,
// which blew through the Hobby tier in a month. Moved here so Phase 1's
// rate-limit cure stays cured.

model Session {
  token        String  @id
  userId       String
  userType     String
  userName     String
  userEmail    String?
  userRole     String?
  customerCode String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model Admin {
  id          String @id
  name        String
  email       String @unique
  password    String
  role        String
  // Modül bazlı yetki haritası: { moduleKey: { read, edit, write } }
  // null ise rol bazlı varsayılan uygulanır (admin = tümü açık, developer = kısıtlı).
  permissions Json?
}

model Customer {
  id           String  @id
  code         String  @unique
  name         String
  password     String
  /// Legacy tek-proje alanı. Yeni model: Project.customerId → müşterinin
  /// birden çok projesi olabilir. Bu alan geriye uyumluluk için duruyor.
  project      String
  contactEmail String
  contactPhone String?

  members  CustomerMember[]
  projects Project[]
}

/// Proje — task'ların yaşadığı GitHub repo'suna ve sahibi müşteriye bağlanır.
/// repoMap/clientMap hardcode'larının DB karşılığı; tüm proje dropdown'ları
/// buradan beslenir.
model Project {
  id         String    @id
  name       String    @unique // "CANIAS", "1C ERP"
  repo       String    @unique // GitHub repo adı (org: ERPIDE)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
}

/// Müşteri (firma) altındaki bireysel kullanıcılar. Firma hesabı (Customer,
/// kod+şifre) legacy giriş olarak yaşamaya devam eder; members e-posta+şifre
/// ile girer ve rolüne göre paneli kısıtlı görür.
model CustomerMember {
  id         String   @id
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  /// Panel giriş kimliği — küçük harfe normalize edilir, sistem genelinde unique.
  username   String   @unique
  email      String   @unique
  password   String // bcrypt hash
  /// "yonetici" → talep açma + yorum + dosya; "uye" → görme + yorum;
  /// "gozlemci" → sadece görüntüleme.
  role       String   @default("uye")
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model PocketToken {
  // pkt_<random> prefix from issueToken().
  token      String    @id
  userId     String
  label      String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model PocketData {
  // One row per user — mobile app overwrites whole `data` blob on sync.
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model PocketPushToken {
  // Expo push token is globally unique per device.
  expoPushToken String   @id
  userId        String
  platform      String
  deviceName    String
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @updatedAt

  @@index([userId])
}

// Per-IP/per-route attempt log. checkRateLimit() inserts one row per attempt
// and counts how many fall inside the configured window. A daily cron prunes
// rows older than 24h — at typical traffic the table stays under 10k rows.
model RateLimitHit {
  id        String   @id @default(cuid())
  scope     String
  ipAddress String
  createdAt DateTime @default(now())

  @@index([scope, ipAddress, createdAt])
  @@index([createdAt])
}

model SupportRequest {
  id            String  @id
  channel       String
  customerName  String?
  customerEmail String?
  summary       String?
  // SupportMessage[] — see lib/support-requests.ts.
  transcript    Json
  meta          Json?
  status        String
  // Vapi call.id — idempotency for end-of-call-report webhook.
  externalId    String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([updatedAt])
}

// ── Ticket system ─────────────────────────────────────────────────
// Kullanıcıların /hesabim/destek üzerinden açtığı destek talepleri.
// Admin /admin/tickets üzerinden görür ve yanıtlar.

model Ticket {
  id        String   @id @default(cuid())
  userId    String
  productId String?  // hangi ürün için (finanserpide, captchaerpide vs.)
  subject   String
  status    String   @default("open") // open | in_progress | closed
  priority  String   @default("normal") // normal | urgent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model TicketMessage {
  id             String   @id @default(cuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  role           String   // "user" | "admin"
  authorName     String?
  content        String
  attachmentUrls Json?    // string[]
  createdAt      DateTime @default(now())

  @@index([ticketId])
}

// ── Enflasyon modülü ──────────────────────────────────────────────
// ERPIDE Gerçek Enflasyon Raporu: çok kaynaklı (EVDS/TCMB/World Bank/statik)
// parametre motoru aylık rapor üretir, abone listesine mail atılır.

model InflationSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Panelden girilen aylık manuel değerler (TÜİK/ENAG bülten rakamları).
/// key: "tuik" | "enag" — data: { yearly, monthly, period }.
/// Kayıt yoksa registry.ts'teki gömülü son değerler kullanılır.
model InflationOverride {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model InflationRun {
  id           String    @id @default(cuid())
  period       String    // "2026-08" — raporun ait olduğu ay
  trigger      String    // "cron" | "manual"
  realRate     Float?    // ERPIDE Gerçek Enflasyon (yıllık %)
  officialRate Float?    // Resmi TÜFE (yıllık %)
  liveParams   Int       @default(0)
  totalParams  Int       @default(0)
  // Motorun tam çıktısı: katmanlar + kategori bazlı tüm parametre değerleri.
  data         Json
  createdAt    DateTime  @default(now())
  sentAt       DateTime?
  sentCount    Int       @default(0)

  @@index([createdAt])
}

// ── Sosyal yayın modülü ───────────────────────────────────────────
// Tek kaynaktan çok kanala yayın: erpide.com Gündem + Facebook Sayfası +
// Instagram (Business) + LinkedIn şirket sayfası.
//
// Gündem post'ları eskiden lib/news.ts içinde kod olarak yaşıyordu; her yeni
// post bir deploy demekti. Artık bu tablo tek gerçek kaynak — news.ts'teki
// NEWS array'i yalnızca ilk kurulumda seed olarak okunur.

model SocialPost {
  id String @id @default(cuid())

  /// product-launch | special-day | milestone — Gündem'deki filtre sekmeleri.
  kind    String @default("milestone")
  title   String
  /// Kısa özet (~150 karakter). Gündem kartı + IG/FB caption'ının gövdesi.
  excerpt String
  /// Uzun gövde (Markdown-lite, paragraflar \n\n ile). Gündem + LinkedIn.
  body    String @default("")
  /// string[] — platform caption'larının sonuna eklenir (# olmadan saklanır).
  hashtags Json?
  /// CTA linki. Boşsa ve slug varsa Gündem post'unun kendi URL'i kullanılır.
  linkUrl  String?

  /// Görsel URL'i. Boşsa yayın anında /api/og/post/[slug] otomatik üretilir.
  imageUrl        String?
  imageAlt        String  @default("")
  /// auto → OG görseli üret | upload → imageUrl'deki yüklenmiş görseli kullan
  imageMode       String  @default("auto")
  gradient        String?
  decoration      String?
  decorationSubtitle String?
  imageBackground String?

  /// Gündem'e özel alanlar. Hedeflerde "site" varsa slug zorunludur.
  slug        String? @unique
  badges      Json?
  productSlug String?
  /// Partial<Record<Locale, { title?, excerpt?, body? }>> — TR dışı diller.
  i18n        Json?

  /// draft | scheduled | publishing | published | partial | failed
  status      String    @default("draft")
  /// Gündem'de görünen tarih ve zamanlanmış yayın anı.
  scheduledAt DateTime?
  publishedAt DateTime?
  /// Platform[] — ["site","facebook","instagram","linkedin"]
  targets     Json

  /// manual | holiday-cron — otomatik taslakların kaynağı izlenebilsin.
  source    String  @default("manual")
  /// holiday-cron için tatil slug'ı (aynı tatile iki taslak üretilmesin).
  sourceRef String?
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publications SocialPublication[]

  @@index([status, scheduledAt])
  @@index([publishedAt])
  @@index([source, sourceRef])
}

/// Bir post'un tek bir platformdaki yayın denemesi ve sonucu. Kısmi başarı
/// normaldir: Instagram patlarken LinkedIn geçebilir; her satır kendi
/// durumunu taşır, yeniden deneme yalnızca başarısız satırları tekrarlar.
model SocialPublication {
  id     String     @id @default(cuid())
  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// site | facebook | instagram | linkedin
  platform String
  /// pending | success | failed | skipped
  status   String @default("pending")

  externalId  String?
  externalUrl String?
  error       String?
  attempts    Int      @default(0)
  attemptedAt DateTime?
  publishedAt DateTime?

  @@unique([postId, platform])
  @@index([status])
}

/// Platform başına tek satır — bağlantı durumu ve token'lar.
/// accessToken/refreshToken AES-256-GCM ile şifreli saklanır (lib/social/crypto.ts,
/// SOCIAL_TOKEN_KEY env'i). Panel token'ı asla düz metin döndürmez.
model SocialAccount {
  /// facebook | instagram | linkedin
  platform String @id

  /// Panelde gösterilen hesap adı ("ERPIDE Yazılım A.Ş.").
  displayName String?
  /// Page ID / IG User ID / LinkedIn organization URN.
  externalId  String?

  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?

  connected     Boolean   @default(false)
  lastCheckedAt DateTime?
  lastError     String?
  /// Platforma özel ek alanlar (ör. FB page list, IG username).
  meta          Json?

  updatedAt DateTime @updatedAt
}
